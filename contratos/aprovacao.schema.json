{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "aprovacao.json",
  "description": "Aprovação humana do plano, em plano/aprovacao.json. Grava o texto do ok e o sha256 dos quatro arquivos aprovados; mudar 1 byte em qualquer um deles vence a aprovação e o montar recusa. Só plano/aprovacao.py escreve este arquivo (quem é medido não assina). Caminhos relativos à pasta do projeto.",
  "type": "object",
  "additionalProperties": false,
  "required": ["versao", "projeto", "aprovado_em", "ok", "arquivos", "emissor"],
  "properties": {
    "versao": {"const": 1},
    "projeto": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$"},
    "aprovado_em": {"$ref": "#/$defs/instante"},
    "ok": {"type": "string", "minLength": 2, "maxLength": 2000, "pattern": "\\S", "description": "O texto do ok do aluno, como ele escreveu no chat."},
    "arquivos": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roteiro", "projeto", "plano", "inserts"],
      "properties": {
        "roteiro": {"$ref": "#/$defs/arquivo"},
        "projeto": {"$ref": "#/$defs/arquivo"},
        "plano": {"$ref": "#/$defs/arquivo"},
        "inserts": {"$ref": "#/$defs/arquivo", "description": "O inserts.json que entrada/para_motor gerou a partir do roteiro e do projeto."}
      }
    },
    "emissor": {"const": "plano.aprovacao", "description": "Módulo que escreveu o arquivo. Outro emissor reprova."}
  },
  "$defs": {
    "instante": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"},
    "caminho": {"type": "string", "minLength": 1, "maxLength": 300, "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(^|/)\\.\\.(/|$))[^\\\\\\x00]+$"},
    "arquivo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["caminho", "sha256"],
      "properties": {
        "caminho": {"$ref": "#/$defs/caminho"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
