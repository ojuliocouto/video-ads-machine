# video-ads-machine: variáveis de ambiente.
#
# Copie para .env (o `bash scripts/setup.sh` já faz isso se o .env não existir) e preencha só
# o que você usa. O .env fica fora do git: NUNCA commite chave.
# O doctor e os comandos `vam` leem o .env da raiz do repo; variável já exportada no seu terminal
# vale mais que a do .env. Para um script avulso, exporte tudo antes:
#   set -a; source .env; set +a
# Tudo o que está comentado com `#` já funciona com o padrão indicado; descomente só para mudar.
# Confira o ambiente com: python3 scripts/vam.py doctor

# ---------------------------------------------------------------------------------------------
# 1. Chaves de API (as únicas linhas ativas deste arquivo)
# ---------------------------------------------------------------------------------------------

# HeyGen: só para o modo avatar (o rosto vem do HeyGen, a voz é a sua). O modo gravado e o
# one-shot funcionam sem ela. Crie em https://app.heygen.com (Settings, API). A conta é
# paga por uso, em dólar; o doctor mostra o saldo.
HEYGEN_API_KEY=

# Groq: transcrição na nuvem (whisper-large-v3-turbo), a reserva quando a máquina não tem
# parakeet (Apple Silicon) nem faster-whisper. Paga por uso. Crie em https://console.groq.com
GROQ_API_KEY=

# Escape raríssimo: trocar o engine do avatar. O motor trava em avatar_v (o que dá lip-sync
# realista); outro engine só com este override explícito, assumindo a perda de qualidade.
# HEYGEN_ENGINE_OVERRIDE=

# ---------------------------------------------------------------------------------------------
# 2. Onde ficam os seus arquivos (padrão: tudo dentro de <repo>/_local, que o git ignora)
# ---------------------------------------------------------------------------------------------

# A pasta do seu material (configs, roteiros, logo). Padrão: <repo>/_local
# VAM_ESTADO=

# A mídia pesada (avatares, vozes, inserts e as saídas). Padrão: <VAM_ESTADO>/dados
# VAM_DADOS=

# Nome antigo de VAM_DADOS, aceito para não quebrar instalações que já usavam.
# VAM_V1_HOME=

# Entradas e saídas, se quiser separar. Padrão: <VAM_DADOS>/inputs e <VAM_DADOS>/output
# VAM_INPUTS=
# VAM_OUTPUT=

# Roteiros anotados. Padrão: <VAM_ESTADO>/roteiros
# VAM_ROTEIROS=

# Arte do anúncio (logo, wordmark). Padrão: <repo>/assets
# VAM_ASSETS=

# Fontes. Padrão: <repo>/fonts
# VAM_FONTS=

# ---------------------------------------------------------------------------------------------
# 3. Montagem do anúncio
# ---------------------------------------------------------------------------------------------

# Trilha de fundo (caminho do arquivo). Padrão: o primeiro assets/som/musica_fundo.* que existir;
# sem arquivo, o anúncio sai sem trilha e avisa. O repo não traz música (licença).
# VAM_MUSICA=

# Quantos segmentos o render faz ao mesmo tempo. Padrão: 4. Em máquina fraca, 2.
# VAM_PARALELO=4

# Cache de segmentos já renderizados e do overlay. Padrão: ligados. 0 desliga.
# VAM_CACHE_SEG=1
# CACHE_OVERLAY=1

# Legenda queimada no footage (1) ou só no overlay (0). Padrão: 1.
# CAP=1

# Lettering gravado na imagem das cenas (1) em vez de camada separada. Padrão: 0.
# VAM_BAKE_LETTERING=0

# Crossfade entre cenas, em segundos (padrão 0.08) e nos cortes secos (padrão 0.04). O tipo:
# auto escolhe por corte; ou o nome fixo de um xfade do ffmpeg.
# VAM_XF=0.08
# VAM_XF_SECO=0.04
# VAM_XF_TIPO=auto

# Split (insert em cima, avatar embaixo): altura do bloco de cima em px (padrão 1150) e
# suavização da emenda (padrão 90). O bias do rosto é MEDIDO no próprio avatar; só ponha
# VAM_SPLIT_BIAS (fração de 0 a 1) como exceção, quando a medição errar.
# VAM_SPLIT_TOP_H=1150
# VAM_SPLIT_GRAD=90
# VAM_SPLIT_BIAS=

# Escala da legenda do estilo editorial. Padrão: 1.0 (canvas 1080x1920 idêntico à referência).
# VAM_ED_SCALE=1.0

# Aceleração da fala, usada pelo gate de colisão para converter tempos. Padrão: 1.35 (avatar).
# VAM_ACCEL=1.35
# Fator de aceleração do utilitário acelerar.py. Padrão: 1.2.
# FATOR=1.2

# Seguir mesmo com insert congelado (1). Só com o motivo anotado no plano. Padrão: 0.
# VAM_IGNORA_CONGELA=0

# ---------------------------------------------------------------------------------------------
# 4. Entradas de um build avulso (scripts legados; o fluxo novo usa o projeto do aluno)
# ---------------------------------------------------------------------------------------------

# Vídeo do avatar, roteiro anotado, nome do arquivo de saída, mapa de inserts.
# VAM_AVATAR=
# VAM_ROTEIRO=
# VAM_OUT=
# VAM_INSERTS_JSON=

# Texto e fim (segundos) do hook, quando o build o recebe de fora.
# VAM_HOOK_TEXT=
# VAM_HOOK_END=0

# ---------------------------------------------------------------------------------------------
# 5. Higienização do áudio (higienizar_audio.py). Valores em segundos, exceto onde indicado.
#    Os padrões foram medidos; mexa só com um problema de áudio na frente.
# ---------------------------------------------------------------------------------------------

# Silêncio maior que isso é pausa de respiração e é encurtado. Padrão: 0.55
# BIG_SIL=0.55
# Pausa natural que sobra depois do corte (piso). Padrão: 0.26
# KEEP_PAUSE=0.26
# Teto da pausa NA TELA, já com a aceleração. Padrão: 0.60
# PAUSA_MAX_TELA=0.60
# Aceleração final usada na conta do teto. Padrão: 1.35
# ACCEL_FINAL=1.35
# Teto da pausa no arquivo. Padrão: PAUSA_MAX_TELA vezes ACCEL_FINAL
# KEEP_PAUSE_MAX=
# Fatia da pausa original que fica. Padrão: 0.20
# KEEP_PAUSE_RATIO=0.20
# Limiar de silêncio em dB. Padrão: -36
# SIL_DB=-36
# Distância mínima entre o corte e a borda da fala vizinha. Padrão: 0.14
# MARGEM_FALA=0.14
# Duração mínima de silêncio para o detector. Padrão: 0.28
# MINDET=0.28
# Quanto de silêncio fica antes e depois da fala. Padrão: 0.12 e 0.30
# LEAD_KEEP=0.12
# TRAIL_KEEP=0.30
# Fade de cada corte. Padrão: 0.012
# FADE=0.012
# Silêncios com menos que isso entre si viram uma pausa só. Padrão: 0.08
# MERGE_GAP=0.08
# Tamanho do modelo faster-whisper na higienização. Padrão: small
# WHISPER_SIZE=small

# ---------------------------------------------------------------------------------------------
# 6. Portões do build. Cada um BARRA o anúncio ruim; desligar é exceção, com o motivo anotado
#    no projeto. Padrão: todos ligados (nada aqui precisa ser descomentado no dia a dia).
# ---------------------------------------------------------------------------------------------

# 0 desliga o portão de fases (ingestão, avatar, plano aprovado).
# FASE_GATE=1
# 1 libera um anúncio que não pertence a nenhuma leva registrada (modo legado).
# FASE_GATE_LEGADO=0
# 0 desliga a fidelidade da fala ao roteiro ou ao documento de origem.
# FIDELIDADE=1
# 0 desliga a re-transcrição obrigatória do áudio higienizado.
# CHECAR_FALA=1
# 0 desliga o gate de ritmo, de colisão de texto e de contraste da legenda.
# GATE_RITMO=1
# GATE_COLISAO=1
# GATE_CONTRASTE=1
# Formato que os gates medem: 9x16 ou 1x1. O build define sozinho; não precisa mexer.
# GATE_FMT=9x16

# Opcional: Google Doc com comentarios como entrada (token OAuth do PROPRIO usuario)
# GOOGLE_OAUTH_ACCESS_TOKEN=
