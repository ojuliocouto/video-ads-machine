# Copy to .env and fill in. The .env file is gitignored: NEVER commit it.

# --- Required ---------------------------------------------------------------
# HeyGen API key (paid plan). Get it at https://app.heygen.com
# under Space Settings > API.
HEYGEN_API_KEY=

# --- Optional: upload finished videos to Google Drive ------------------------
# Path to a JSON file with your Google OAuth tokens
# (access_token/refresh_token/client_id/client_secret or compatible).
# Only needed if you set drive_folder in config.yaml.
# GOOGLE_OAUTH_TOKEN_FILE=~/.config/vam/google-tokens.json
