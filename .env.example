# Copie para .env e preencha. O .env NUNCA vai pro git.

# --- Obrigatorio ---
# Avatar (HeyGen). Pegue em https://app.heygen.com (Settings > API). Plano pago.
HEYGEN_API_KEY=

# --- Opcional: roteiro via Google Sheets (senao use YAML local) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# caminho do arquivo de tokens OAuth (gerado no primeiro login)
GOOGLE_TOKENS_FILE=~/.config/vam/google-tokens.json

# --- Opcional: notificacao de progresso no WhatsApp (uazapi) ---
UAZAPI_SERVER=
UAZAPI_INSTANCE_TOKEN=
UAZAPI_NOTIFY_NUMBER=
